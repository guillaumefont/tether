extends SceneTree
# Regenerates scripts/medal_times.gd: the reference times the medal targets come from.
# The AI drives a Time Trial on every track and variant (fixed seed, best of 3 runs);
# reference = its best lap (its run score on Collect, which scores the whole run).
# Usage: godot --headless --path . --script tools/gen_medals.gd
const TrackData = preload("res://scripts/track.gd")
const Race = preload("res://scripts/race.gd")
const Defs = preload("res://scripts/track_defs.gd")

func _init() -> void:
	var out := "# Generated by tools/gen_medals.gd: AI reference time per track and variant\n"
	out += "# (best lap, or run score on Collect). Rerun the tool after changing a layout.\n"
	out += "extends RefCounted\n\nconst REF := {\n"
	for d in Defs.TRACKS:
		var line := "\t\"%s\": { " % d["name"]
		for v in Defs.VARIANTS:
			var best := INF
			for run in 3:
				seed(1000 + run)
				var tr := TrackData.new(d, v[0])
				var race := Race.new(tr, "trial", 1)
				var c = race.cars[0]
				var dt := 1.0 / 60.0
				while race.clock < 400.0 and not c.finished:
					race.ai_think(c)
					race.inputs[0]["held"] = c.hook >= 0
					race.update(dt)
					race.events.clear()
				var ref: float = c.finish_time if v[0] == "collect" else c.best_lap
				if c.finished and ref > 0.0:
					best = minf(best, ref)
			line += "\"%s\": %.2f, " % [v[0], best]
		out += line + "},\n"
	out += "}\n"
	var f := FileAccess.open("res://scripts/medal_times.gd", FileAccess.WRITE)
	f.store_string(out)
	f.close()
	printerr(out)
	quit()
